# Sepolia RPC endpoint (get from Infura/Alchemy)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# Private key of faucet wallet (with or without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Amount to send per request (in ETH)
FAUCET_AMOUNT=0.005

# Master password (optional - bypasses balance check and rate limit)
# Leave empty to disable admin mode
MASTER_PASSWORD=your-secret-password

# Allowed origins for CORS (comma-separated)
# Use * for all origins or specify domains
ALLOWED_ORIGINS=*
