                  "});",
                  "",
                  "pm.test(\"Defaults to Sepolia\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.network).to.eql('Sepolia');",
                  "    pm.expect(jsonData.currency).to.eql('ETH');",
                  "    pm.expect(jsonData.amount).to.eql('0.005');",
