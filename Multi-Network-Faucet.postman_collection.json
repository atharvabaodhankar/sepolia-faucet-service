            "description": "Test backward compatibility - missing network parameter should default to Sepolia.\n\n**Expected:**\n- Status: 200\n- Network: \"Sepolia\"\n- Currency: \"ETH\"\n- Amount: \"0.005\""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
